[Unit]
Description=vpsdash private operations dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h
ExecStart=%h/bin/vpsdash --config %h/.config/vpsdash/config.json
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
Environment=PATH=/home/vpsdash/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

[Install]
WantedBy=default.target
